[resource]
script = ExtResource("1_dllj8")
name = "Nook"
origin = "Born in the right-angled nebulas of the Geometry Sector, the Nook is a creature of pure alignment. It doesn't breathe oxygen or drink water; it feeds on the structural stability of ninety-degree joints. To this alien, a corner isn't just a place to sit; it's a charging station. Placing it in the middle of a floor is like trying to use a battery that isn't plugged in."
alien_trait = "The Nook seeks corners, when put in any of the 4 corners of the Pen, increases yield value by +12."
price = 130
rate = 44
