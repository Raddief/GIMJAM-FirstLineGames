[resource]
script = ExtResource("1_2dxtf")
name = "Bard Toad"
origin = "The Bard Toad is the galaxy's most famous nomad. It travels from planet to planet via passing comets and solar winds, touring every known star system to share its melodies. You can find traces of its \"Galactic Tour\" everywhere. It only stays in your zoo for the snacks and the chance for a new audience."
alien_trait = "All aliens directly 1 tile above, below, or beside Bard Toad gain +8 Credit yield. Only effects coming from the same instance of Bard Toad stacks."
